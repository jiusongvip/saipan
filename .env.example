# 复制为 .env.local（不提交）。取值必须由负责人确认后填写，未确认前留空即可，
# 留空时站点会安全降级（表单不提交、分析不加载、草稿可见性仅限本地/预览）。

# 集团表单接口 POST /api/contact 的完整 URL。契约见 docs/decisions/ADR-002-api-contract.md（BLOCKED）。
# 未配置时 ContactForm 不会发起任何请求，改为展示已确认的联络渠道。
PUBLIC_CONTACT_API_URL=

# GA4。未配置时不加载任何分析脚本；配置后仍受同意组件控制。
PUBLIC_GA4_MEASUREMENT_ID=

# 构建闸门：设为 1 时把 draft/review 页面一并构建，仅供内部预览，禁止用于生产。
INCLUDE_DRAFTS=
