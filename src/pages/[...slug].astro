---
import { buildVisible, loadAllPages, pathToRoute, type PageData } from '../lib/content';
import { pageView } from '../lib/page-view';
import HomeLayout from '../layouts/HomeLayout.astro';
import DestinationLayout from '../layouts/DestinationLayout.astro';
import PricingLayout from '../layouts/PricingLayout.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import LandingLayout from '../layouts/LandingLayout.astro';

export async function getStaticPaths() {
  return buildVisible(await loadAllPages()).map((page) => ({
    params: { slug: pathToRoute(page.path) },
    props: { page },
  }));
}

interface Props {
  page: PageData;
}
const { page } = Astro.props;
const view = pageView(page);
const Layout = {
  home: HomeLayout,
  destination: DestinationLayout,
  pricing: PricingLayout,
  landing: LandingLayout,
  content: ContentLayout,
}[view];
const rendered = view === 'home' ? null : await page.render?.();
const Content = rendered?.Content;
---

<Layout page={page} lang={page.lang} withForm={page.template !== 'contact_success'}>
  {Content && <Content />}
</Layout>
