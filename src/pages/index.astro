---
import '../styles/marketing-home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { canonicalUrl } from '../lib/seo';
import { buildVisiblePaths, loadAllPages, visibleArticles } from '../lib/content';
import { heroImage, siteConfig } from '../lib/config';
import { t } from '../lib/i18n';

// 根路径直接渲染简体中文营销首页（用户 2026-10-14 拍板）；其余语言仍在各自 /<lang> 首页。
// 首图用用户提供的塞班潟湖航拍实景（同一素材与 heroImage 配置，题注按拍板不渲染）；
// 视觉主色走本层专用马尔代夫蓝，不改 tokens.css。
const LANG = 'zh-hans';

const pages = await loadAllPages();
const built = buildVisiblePaths(pages);
// 内链只落在本次构建真实渲染的页：某页被撤下时降级为纯文本，不留 404 入口。
const link = (path: string): string | null => (built.has(path) ? path : null);
// 按优先级取第一个真实存在的落点：简体专区页仍在补齐，缺页时退到对应的科普页，按钮不会整块消失。
const anyLink = (...paths: string[]): string | null => paths.find((path) => built.has(path)) ?? null;

const svg = (body: string) =>
  `<svg class="mi" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;

// 图标几何取自 Lucide（https://github.com/lucide-icons/lucide，ISC 授权，lucide-static v1.57.0）。
// 只借 24×24 网格上的 path 数据，外层属性由上面的 svg() 统一给（stroke-width 1.6 而非 Lucide 默认的 2），
// 因此不引依赖、不进 lockfile、产物仍是内联 SVG。改动范围仅根首页（用户 2026-10-15 拍板）。
const icons = {
  shield: svg('<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />'),
  doc: svg('<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" />'),
  scale: svg('<path d="M12 3v18" /><path d="m19 8 3 8a5 5 0 0 1-6 0zV7" /><path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1" /><path d="m5 8 3 8a5 5 0 0 1-6 0zV7" /><path d="M7 21h10" />'),
  users: svg('<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><path d="M16 3.128a4 4 0 0 1 0 7.744" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><circle cx="9" cy="7" r="4" />'),
  plane: svg('<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />'),
  palm: svg('<path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4" /><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3" /><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35" /><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14" />'),
  flask: svg('<path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2" /><path d="M6.453 15h11.094" /><path d="M8.5 2h7" />'),
  receipt: svg('<path d="M13 16H8" /><path d="M14 8H8" /><path d="M16 12H8" /><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z" />'),
  chart: svg('<path d="M3 3v16a2 2 0 0 0 2 2h16" /><path d="M18 17V9" /><path d="M13 17V5" /><path d="M8 17v-3" />'),
  lang: svg('<path d="m5 8 6 6" /><path d="m4 14 6-6 2-3" /><path d="M2 5h12" /><path d="M7 2h1" /><path d="m22 22-5-10-5 10" /><path d="M14 18h6" />'),
  book: svg('<path d="M12 5v16" /><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z" />'),
  calendar: svg('<path d="M8 2v3" /><path d="M16 2v3" /><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18" /><path d="M8 13h.01" /><path d="M12 13h.01" /><path d="M16 13h.01" /><path d="M8 17h.01" /><path d="M12 17h.01" /><path d="M16 17h.01" />'),
  heart: svg('<path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" />'),
  lock: svg('<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />'),
  search: svg('<path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" />'),
  hospital: svg('<path d="M12 7v4" /><path d="M14 21v-3a2 2 0 0 0-4 0v3" /><path d="M14 9h-4" /><path d="M18 11h2a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2h2" /><path d="M18 21V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16" />'),
  doctor: svg('<path d="M11 2v2" /><path d="M5 2v2" /><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1" /><path d="M8 15a6 6 0 0 0 12 0v-3" /><circle cx="20" cy="10" r="2" />'),
  baby: svg('<path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5" /><path d="M15 12h.01" /><path d="M19.38 6.813A9 9 0 0 1 20.8 10.2a2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1" /><path d="M9 12h.01" />'),
  route: svg('<circle cx="6" cy="19" r="3" /><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" /><circle cx="18" cy="5" r="3" />'),
  globe: svg('<circle cx="12" cy="12" r="10" /><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z" />'),
};

const heroChips = [
  { icon: icons.shield, text: '免签或线上授权 · 不必面签' },
  { icon: icons.plane, text: '台北直飞约 3–4 小时' },
  { icon: icons.lang, text: '中文与多语种全程陪同' },
  { icon: icons.baby, text: '新生儿出生证件流程指引' },
];

const trust = [
  { icon: icons.shield, title: '免签或线上授权', note: '不必面签 · 出发前就能确认' },
  { icon: icons.plane, title: '就近可达', note: '台北直飞 · 日韩中转成熟' },
  { icon: icons.doc, title: '新生儿证件指引', note: '出生登记 · 护照与旅行证件' },
  { icon: icons.scale, title: '法律与亲权框架', note: '合规路径 · 书面材料清单' },
  { icon: icons.hospital, title: '美国医疗体系', note: '院方流程 · 实验室与病历' },
  { icon: icons.palm, title: '疗愈环境', note: '海岛休养 · 多语种团队' },
];

const whyCards = [
  { icon: icons.route, title: '跨境出行与就医安排', body: '直飞与中转怎么选、住多久、停留时间与就诊节奏怎么排在一起。', href: link('/zh-hans/entry-path'), cta: '了解出行指南' },
  { icon: icons.hospital, title: '医疗资源与服务可及性', body: '合作机构与实验室的资质怎么查、病历与准入条件要准备什么。', href: anyLink('/zh-hans/hospital-lab', '/zh-hans/articles/lab-own-or-outsourced'), cta: '查看医疗资源' },
  { icon: icons.lang, title: '语言与跨境协调', body: '多语种协调员、翻译服务与紧急沟通安排，全程用您习惯的语言。', href: link('/zh-hans/articles/translation-and-support-arrangements'), cta: '了解语言支持' },
  { icon: icons.scale, title: '法律与政策可行性', body: '辅助生殖政策、亲权认定与各国证件要求，逐项写明以哪份文件为准。', href: anyLink('/zh-hans/legal/parenthood-and-birth-registration', '/zh-hans/articles/entry-policy-change-what-to-check'), cta: '了解法律与证件' },
  { icon: icons.receipt, title: '费用与时间成本', body: '医疗费用、药物、住宿交通与可能的额外支出，分开列给您看。', href: anyLink('/zh-hans/pricing', '/zh-hans/articles/price-ranges-and-addon-items'), cta: '查看费用构成' },
];

const medicalPoints = [
  { icon: icons.hospital, title: '合作医疗机构', note: '要求出示执业资质' },
  { icon: icons.doctor, title: '医生团队', note: '先看资历再谈方案' },
  { icon: icons.flask, title: '实验室与流程', note: '培养与检测在同一地' },
  { icon: icons.receipt, title: '透明的治疗项目', note: '分项报价 · 不含项写清' },
  { icon: icons.chart, title: '临床数据怎么看', note: '口径、分母与来源' },
];

const beyondPoints = [
  { icon: icons.search, title: '医疗资源可核验', body: '合作机构与医生资质，先给您可查的书面材料。' },
  { icon: icons.receipt, title: '费用结构透明', body: '分项报价，并写明哪些项目不包含在内。' },
  { icon: icons.lang, title: '母语沟通与就医协调', body: '多语种团队从初诊陪同到返国后追踪。' },
  { icon: icons.book, title: '跨境事务有清晰指引', body: '出行、住宿、证件与停留期限一次说清。' },
  { icon: icons.lock, title: '尊重个人情况与隐私', body: '个性化方案，资料按最小必要范围保存。' },
  { icon: icons.calendar, title: '时间线看得见', body: '每一阶段做什么、要准备什么、大约多久。' },
];

const audiences = [
  { icon: icons.baby, title: '高龄或卵巢储备下降', body: '先看评估方式与可选方案，再谈流程与费用。', href: anyLink('/zh-hans/programs/donor-egg', '/zh-hans/articles/amh-low-ovarian-reserve'), cta: '查看方案与评估说明' },
  { icon: icons.search, title: '多次 IVF 失败', body: '病历整理、第二意见与下一步怎么给。', href: anyLink('/zh-hans/programs/recurrent-implantation-failure', '/zh-hans/programs/ivf-icsi'), cta: '查看方案说明' },
  { icon: icons.heart, title: '单身人士与 LGBTQ+ 家庭', body: '政策准入、亲权认定与隐私保护逐项说明。', href: anyLink('/zh-hans/programs/lgbtq-single-family', '/zh-hans/programs/ivf-icsi'), cta: '查看方案说明' },
  { icon: icons.globe, title: '正在规划跨境治疗', body: '行程安排、费用构成与需要准备的辅助材料。', href: anyLink('/zh-hans/programs/remote-consult-local-followup', '/zh-hans/tools'), cta: '查看流程与工具' },
];

const articleTopics: Record<string, string> = {
  'flights-to-saipan-routes': '出行与航线',
  'price-ranges-and-addon-items': '费用解析',
  'us-born-baby-advantages': '出生证件',
  'documents-before-first-visit': '就诊准备',
  'entry-policy-change-what-to-check': '政策更新',
  'how-to-read-success-statistics': '数据解读',
  'lab-own-or-outsourced': '医疗资源',
  'ivf-abroad-decision-checklist': '决策清单',
  'stay-itinerary-planning': '行程规划',
  'translation-and-support-arrangements': '语言支持',
  'cancellation-and-refund-questions': '费用解析',
  'confidentiality-and-privacy-on-trip': '隐私保护',
};

// 资讯卡取本次构建真实存在的简体科普，按获客优先级排序后取三条。
const newsOrder = ['flights-to-saipan-routes', 'price-ranges-and-addon-items', 'us-born-baby-advantages', 'documents-before-first-visit'];
const newsPool = visibleArticles(pages, LANG);
const slugOf = (path: string) => path.slice(path.lastIndexOf('/') + 1);
const preferred = newsOrder
  .map((slug) => newsPool.find((article) => slugOf(article.path) === slug))
  .filter((article): article is (typeof newsPool)[number] => Boolean(article));
const news = [...preferred, ...newsPool.filter((article) => !newsOrder.includes(slugOf(article.path)))].slice(0, 3);

const reassurance = [
  { icon: icons.users, title: '专业团队跟进', note: '按您选择的管道与语言回复' },
  { icon: icons.heart, title: '初步咨询免费', note: '不涉及医疗诊断与用药建议' },
  { icon: icons.lock, title: '信息安全保护', note: '最小必要范围留存，不用于营销共享' },
];

const whySaipanPath = anyLink('/zh-hans/why-saipan', '/zh-hans/articles/saipan-vs-us-mainland');
const articlesPath = link('/zh-hans/articles');
const hospitalPath = anyLink('/zh-hans/hospital-lab', '/zh-hans/programs/ivf-icsi');
const entryPath = link('/zh-hans/entry-path');
const guidesPath = articlesPath;
---

<BaseLayout
  lang={LANG}
  title={`塞班 IVF · 您的安心之选｜${siteConfig.primary_domain.value}`}
  description="免签或线上授权即可出发，台北直飞约三四个小时。从方案选择、入境停留、费用构成到新生儿出生证件，本站把每一项拆成可逐条了解的页面，先看清再决定。"
  canonical={canonicalUrl('/')}
  noindex={false}
  pageType="home"
  page={null}
  hasForm={true}
>
  <section class="mhero">
    <div class="mhero__glow" aria-hidden="true"></div>
    <div class="container mhero__grid">
      <div class="mhero__copy">
        <p class="mhero__eyebrow">SAIPAN IVF · 北马里亚纳群岛</p>
        <h1>遵循严谨医学标准，<br />提供透明辅助生殖方案。</h1>
        <p class="mhero__sub">塞班 IVF，您的安心之选。</p>
        <p class="mhero__lede">免签或线上授权就能出发，台北直飞约三四个小时。方案怎么选、能停留多久、要花多少、孩子出生后的证件怎么办——我们把这四件事逐项拆开写清楚，让您在订机票之前就能判断。</p>
        <div class="mhero__actions">
          <a class="btn btn--light" href="#consult">预约初步咨询</a>
          {whySaipanPath && <a class="btn btn--outline" href={whySaipanPath}>了解塞班 IVF</a>}
        </div>
        <ul class="mhero__chips">
          {heroChips.map((chip) => (
            <li>
              <span class="mchip__icon" set:html={chip.icon} />
              {chip.text}
            </li>
          ))}
        </ul>
      </div>
      <div class="mhero__panel">
        <img
          class="mhero__photo"
          src={heroImage.src}
          alt={t(LANG, 'hero.image_alt')}
          width={heroImage.width}
          height={heroImage.height}
          loading="eager"
          decoding="async"
        />
        <p class="mhero__script" aria-hidden="true">
          <span>Saipan</span>
          <em>More than a destination.</em>
          <em>A new beginning.</em>
        </p>
      </div>
    </div>
  </section>

  <section class="mtrust" aria-label="核心要点">
    <div class="container mtrust__grid">
      {trust.map((item) => (
        <div class="mtrust__item">
          <span class="mtrust__icon" set:html={item.icon} />
          <p class="mtrust__title">{item.title}</p>
          <p class="mtrust__note">{item.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section mwhy">
    <div class="container">
      <div class="mhead">
        <div>
          <p class="mhead__kicker">Why Saipan</p>
          <h2>为什么把塞班放进您的辅助生殖选择里</h2>
          <p class="mhead__lede">从医疗资源、出行安排到法律政策，五个维度逐项评估这座岛的实际条件与限制。</p>
        </div>
        {whySaipanPath && <a class="mlink" href={whySaipanPath}>看看塞班与其他目的地的差别</a>}
      </div>
      <ul class="mgrid mgrid--why">
        {whyCards.map((card) => (
          <li class="mcard">
            <span class="mcard__icon" set:html={card.icon} />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            {card.href && <a class="mlink mlink--tight" href={card.href}>{card.cta}</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt mmedical">
    <div class="container msplit">
      <div class="msplit__visual" aria-hidden="true">
        <span class="msplit__bigicon" set:html={icons.flask} />
        <p class="msplit__caption">Trusted Medical Care</p>
      </div>
      <div>
        <p class="mhead__kicker">Trusted Medical Care</p>
        <h2>为什么可以信任这里的医疗服务</h2>
        <p class="mhead__lede">我们与正规医疗机构合作，把每一项资质、每一份数据都留在可以要求出示的位置——您不需要凭我们的说法做决定。</p>
        <ul class="mpoints">
          {medicalPoints.map((point) => (
            <li>
              <span class="mpoints__icon" set:html={point.icon} />
              <span class="mpoints__text">
                <strong>{point.title}</strong>
                <small>{point.note}</small>
              </span>
            </li>
          ))}
        </ul>
        {hospitalPath && <a class="btn btn--primary" href={hospitalPath}>了解更多医疗信息</a>}
      </div>
    </div>
  </section>

  <section class="section mbeyond">
    <div class="container">
      <div class="mhead">
        <div>
          <p class="mhead__kicker">Beyond the Clinic</p>
          <h2>不止于预约，帮您看清整个跨境就医过程</h2>
          <p class="mhead__lede">从医疗资源到行程安排，我们提供全流程的专业支持，让跨境就医更简单，也更安心。</p>
        </div>
      </div>
      <ul class="mgrid mgrid--beyond">
        {beyondPoints.map((point) => (
          <li class="mline">
            <span class="mline__icon" set:html={point.icon} />
            <span>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </span>
          </li>
        ))}
      </ul>
      {guidesPath && <a class="btn btn--primary" href={guidesPath}>浏览全部科普指南</a>}
    </div>
  </section>

  <section class="section section--alt maudience">
    <div class="container">
      <div class="mhead">
        <div>
          <p class="mhead__kicker">Who We Help</p>
          <h2>为不同情况的您，提供针对性的方案</h2>
          <p class="mhead__lede">每个家庭的情况都不一样。先说清您现在的处境，我们再给出对应要问的问题与要准备的材料。</p>
        </div>
      </div>
      <ul class="mgrid mgrid--aud">
        {audiences.map((card) => (
          <li class="mcard mcard--photo">
            <span class="mcard__band" set:html={card.icon} />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            {card.href && <a class="mlink mlink--tight" href={card.href}>{card.cta}</a>}
          </li>
        ))}
      </ul>
      <p class="maudience__foot">没找到与您对应的情况？留下您的情形，我们会说明这类情况通常要确认哪些事项。</p>
    </div>
  </section>

  <section class="section mnews">
    <div class="container">
      <div class="mhead">
        <div>
          <p class="mhead__kicker">Guides &amp; Updates</p>
          <h2>专业指南与最新资讯</h2>
          <p class="mhead__lede">获取塞班 IVF 的入境政策、费用流程与就诊准备等实用信息。</p>
        </div>
        {articlesPath && <a class="mlink" href={articlesPath}>查看更多文章</a>}
      </div>
      <ul class="mgrid mgrid--news">
        {news.map((article) => {
          const slug = slugOf(article.path);
          return (
            <li class="mcard mcard--news">
              <span class="mcard__thumb">
                <span class="mcard__tag">{articleTopics[slug] ?? '实用指南'}</span>
              </span>
              <h3><a href={article.path}>{article.title}</a></h3>
              <p>{article.description}</p>
              <a class="mlink mlink--tight" href={article.path}>阅读全文</a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="mreassure">
    <div class="container mreassure__grid">
      <div class="mhead mhead--inline">
        <div>
          <p class="mhead__kicker">Get Started</p>
          <h2>预约初步咨询</h2>
          <p class="mhead__lede">告诉我们您现在的情况，我们会由合适的人员为您提供初步建议与支持。</p>
        </div>
      </div>
      <ul class="mreassure__list">
        {reassurance.map((item) => (
          <li>
            <span class="mreassure__icon" set:html={item.icon} />
            <span>
              <strong>{item.title}</strong>
              <small>{item.note}</small>
            </span>
          </li>
        ))}
      </ul>
    </div>
    {entryPath && <p class="mreassure__note container">还在比较目的地？先看这一页：<a class="mlink mlink--tight" href={entryPath}>入境与停留要求</a>。</p>}
  </section>

  <ContactForm lang={LANG} pageType="home" pagePath="/" ctaLabel="预约初步咨询" />
</BaseLayout>
