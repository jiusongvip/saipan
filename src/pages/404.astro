---
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalUrl } from '../lib/seo';
import { defaultLanguage, enabledLanguages, siteConfig } from '../lib/config';
import { languageHomeIfBuilt, loadAllPages } from '../lib/content';
import { t } from '../lib/i18n';

const pages = await loadAllPages();
const built = enabledLanguages.flatMap((lang) => {
  const path = languageHomeIfBuilt(pages, lang.code);
  return path ? [{ label: lang.native_label, path }] : [];
});
---

<BaseLayout
  lang={defaultLanguage}
  title={`404 · ${t(defaultLanguage, 'page.not_found_title')} · ${siteConfig.primary_domain.value}`}
  description={t(defaultLanguage, 'page.not_found_description')}
  canonical={canonicalUrl('/404')}
  noindex={true}
  pageType="not_found"
>
  <section class="section">
    <div class="container container--narrow">
      <h1>404 · {t(defaultLanguage, 'page.not_found_title')}</h1>
      <p>{t(defaultLanguage, 'page.not_found_description')}</p>
      <ul class="grid-cards card-list-reset">
        {built.map(({ label, path }) => (
          <li class="card">
            <h2 class="card__title"><a href={path}>{label}</a></h2>
          </li>
        ))}
      </ul>
      {built.length === 0 && (
        <p><a href="/">{siteConfig.primary_domain.value}</a></p>
      )}
    </div>
  </section>
</BaseLayout>
