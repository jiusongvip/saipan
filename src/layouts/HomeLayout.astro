---
import MarketingImage from '../components/marketing/MarketingImage.astro';
import { getHomeCopy } from '../data/marketing/home';
import HeroCarousel from '../components/marketing/HeroCarousel.astro';
import ConsultationPanel from '../components/marketing/ConsultationPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import HomeDiscovery from '../components/HomeDiscovery.astro';
import HomePlanning from '../components/HomePlanning.astro';
import HomeClinical from '../components/HomeClinical.astro';
import { buildVisiblePaths, loadAllPages, type PageData } from '../lib/content';
import { canonicalUrl } from '../lib/seo';
import type { LangCode } from '../lib/config';
import '../styles/editorial-home.css';
import '../styles/light-home.css';
interface Props {
  lang: LangCode;
  page?: PageData | null;
}
const { lang, page = null } = Astro.props;
const copy = getHomeCopy(lang);
const built = buildVisiblePaths(await loadAllPages());
const target = (...paths: string[]) =>
  paths.map((p) => `/${lang}/${p}`).find((p) => built.has(p)) ?? '#consult';
const island = target('why-saipan', 'entry-path');
const alternates = (['zh-hans', 'zh-hant', 'en'] as const)
  .filter((l) => built.has(`/${l}`) || built.has(`/${l}/`))
  .map((l) => ({
    hreflang: l === 'zh-hans' ? 'zh-Hans' : l === 'zh-hant' ? 'zh-Hant' : 'en',
    href: canonicalUrl(l === 'zh-hans' && !page ? '/' : `/${l}`),
  }));
alternates.push({ hreflang: 'x-default', href: canonicalUrl('/') });

const metaTitle = page?.title ?? '塞班辅助生殖｜为新的可能，留一点空间';
const metaDescription =
  page?.description ??
  '在塞班探索辅助生殖的更多可能，了解治疗评估、医疗资源、费用构成与跨境出行安排，从一次清晰的沟通开始。';
---

<BaseLayout
  lang={lang}
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl(page?.path ?? '/')}
  alternates={alternates}
  noindex={page?.noindex ?? false}
  pageType="home"
  page={page}
  hasForm={true}
  ogImage="/images/saipan-lagoon-aerial.jpg"
>
  <HeroCarousel lang={lang} />
  <ConsultationPanel lang={lang} />
  <div class="eh-values">
    <div class="container">
      {copy.nav.map((text, i) => (
        <a
          href={['#medical-care', '#sample-budget', '#first-consultation'][i]}
          data-reveal
          style={`--rd:${i}`}
        >
          {text}
        </a>
      ))}
    </div>
  </div>
  <HomePlanning lang={lang} part="goals" />
  <HomeClinical lang={lang} />
  <HomePlanning lang={lang} part="details" />
  <section class="eh-island">
    <MarketingImage
      src="/images/saipan-lagoon-aerial.jpg"
      alt={copy.imageAlt[4]}
      width="1280"
      height="716"
      loading="lazy"
    />
    <div class="container">
      <div class="eh-island__card" data-reveal>
        <h2>{copy.island}</h2>
        <p>{copy.islandText}</p>
        <a class="eh-link" href={island}>
          {copy.islandLink}
          <span>↗</span>
        </a>
      </div>
    </div>
    <span class="eh-island__word" aria-hidden="true">
      Saipan
    </span>
  </section>
  <HomeDiscovery lang={lang} />
  <section class="eh-start container">
    <h2 data-reveal>{copy.start}</h2>
    <p data-reveal style={`--rd:1`}>
      {copy.startText}
    </p>
    <a class="eh-button eh-button--dark" href="#consult" data-reveal style={`--rd:2`}>
      {copy.consult}
      <span>↗</span>
    </a>
  </section>
  <ContactForm lang={lang} pageType="home" pagePath={page?.path ?? '/'} ctaLabel={copy.consult} />
</BaseLayout>
<script>
  import '../scripts/reveal';
</script>
