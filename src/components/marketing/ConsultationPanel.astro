---
import { getConsultationCopy } from '../../data/marketing/consultation';
import type { LangCode } from '../../lib/config';
interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const c = getConsultationCopy(lang);
---

<aside class="eh-chat" data-consult-panel aria-label={c.label}>
  <div class="eh-chat__header">
    <span class="eh-chat__avatar" aria-hidden="true">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z" />
      </svg>
    </span>
    <div>
      <strong>{c.title}</strong>
      <small>{c.subtitle}</small>
    </div>
    <button type="button" data-consult-close aria-label={c.minimize}>
      −
    </button>
  </div>
  <div class="eh-chat__body">
    <p class="eh-chat__hello">{c.hello}</p>
    <p class="eh-chat__bubble">{c.message}</p>
    <span class="eh-chat__prompt">{c.prompt}</span>
    <div class="eh-chat__topics">
      {c.topics.map((text) => (
        <a href="#consult">
          {text}
          <span>↗</span>
        </a>
      ))}
    </div>
    <a class="eh-chat__cta" href="#consult">
      {c.action}
      <span>→</span>
    </a>
  </div>
</aside>
<button type="button" class="eh-chat-launcher" data-consult-open hidden aria-expanded="false">
  {c.label}
  <span aria-hidden="true">↗</span>
</button>
<script>
  import '../../scripts/consultation-panel';
</script>
