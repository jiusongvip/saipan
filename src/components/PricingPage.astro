---
<BaseLayout lang={lang} title={meta.title} description={meta.description} canonical={meta.canonical} alternates={alternates} noindex={page.noindex} page={page} pageType="pricing" hasForm={true} ogImage="/images/couple-editorial.jpg">
<section class="pp-hero"><div class="container"><div><p class="eh-kicker">COSTS & SERVICES · SAIPAN IVF</p><h1>{c.title}</h1><p>{c.lead}</p><a class="eh-button eh-button--dark" href="#quote-planner">{c.cta}<span>↗</span></a></div><img src="/images/couple-editorial.jpg" alt={en?'Consultation scene illustration':tw?'一對一溝通場景示意':'一对一沟通场景示意'} width="1400" height="933" fetchpriority="high"/></div></section>
<div class="container dp-breadcrumb"><Breadcrumbs lang={lang} page={page}/></div>
<section class="container pp-costs"><p class="eh-kicker">THE WHOLE PICTURE</p><h2>{c.intro}</h2><p class="pp-lede">{c.introText}</p><div>{c.groups.map((title,i)=><article><img src={['/images/laboratory-care.jpg','/images/care-consultation.jpg','/images/stay-room.jpg','/images/flight-wing.jpg'][i]} alt={title} width="1000" height="667" loading="lazy"/><span>0{i+1}</span><h3>{title}</h3><p>{c.notes[i]}</p></article>)}</div><small>{c.noPrice}</small></section>
<section class="pp-services"><div class="container"><div><p class="eh-kicker">CARE BEYOND THE CLINIC</p><h2>{c.service}</h2><p class="pp-lede">{c.serviceText}</p></div><div>{c.services.map((title,i)=><article><span>0{i+1}</span><div><h3>{title}</h3><p>{c.serviceNotes[i]}</p></div></article>)}</div></div></section>
<section class="container pp-inclusions"><p class="eh-kicker">ASK BEFORE YOU COMMIT</p><h2>{c.tableTitle}</h2><p class="pp-lede">{c.tableText}</p><div class="dp-table"><table><caption class="visually-hidden">{c.tableTitle}</caption><thead><tr>{c.cols.map(text=><th scope="col">{text}</th>)}</tr></thead><tbody>{c.rows.map(row=><tr>{row.map((text,i)=>i===0?<th scope="row">{text}</th>:<td>{text}</td>)}</tr>)}</tbody></table></div></section>
<section class="pp-planner" id="quote-planner" data-quote-planner><div class="container"><div><p class="eh-kicker">YOUR PERSONAL BRIEF</p><h2>{c.planner}</h2><p class="pp-lede">{c.plannerText}</p><div class="pp-fields">{[{label:c.need,options:c.needs},{label:c.people,options:c.parties},{label:c.room,options:c.rooms}].map((field,i)=><label>{field.label}<select data-quote-select data-result-label={[c.focus,c.companions,c.stay][i]}>{field.options.map(text=><option>{text}</option>)}</select></label>)}</div><button type="button" class="eh-button eh-button--dark" data-quote-generate>{c.generate}<span>↗</span></button></div><div class="pp-brief"><p class="eh-kicker">READY TO DISCUSS</p><h3>{c.result}</h3><div data-quote-result aria-live="polite">{[c.focus,c.companions,c.stay].map((text,i)=><p><strong>{text}</strong><span data-quote-value>{[c.needs[0],c.parties[0],c.rooms[0]][i]}</span></p>)}</div><ul>{c.questions.map(text=><li>{text}</li>)}</ul><div class="pp-brief__actions"><button type="button" data-quote-copy data-copied={c.copied} data-failed={c.copyFail}>{c.copy}</button><a class="eh-link" href="#consult">{c.contact}<span>↗</span></a></div><p data-quote-status role="status"></p></div></div></section>
<section class="container pp-faq"><p class="eh-kicker">CLARITY FIRST</p><h2>{c.faq}</h2><div>{c.qs.map((q,i)=><details><summary>{q}</summary><p>{c.as[i]}</p></details>)}</div><small>{c.note}</small></section>
<div class="container dp-source"><details><summary>{c.details}</summary><slot/></details></div>
<ContactForm lang={lang} pageType="pricing" pagePath={page.path} ctaLabel={c.cta}/>
</BaseLayout>
<script>
 document.querySelectorAll<HTMLElement>('[data-quote-planner]').forEach(planner=>{
 const selects=Array.from(planner.querySelectorAll<HTMLSelectElement>('[data-quote-select]'));
 const values=Array.from(planner.querySelectorAll<HTMLElement>('[data-quote-value]'));
 function update(){selects.forEach((select,i)=>{if(values[i])values[i].textContent=select.value});const status=planner.querySelector<HTMLElement>('[data-quote-status]');if(status)status.textContent=''}
 selects.forEach(select=>select.addEventListener('change',update));
 planner.querySelector('[data-quote-generate]')?.addEventListener('click',()=>{update();planner.querySelector<HTMLElement>('.pp-brief')?.scrollIntoView({block:'nearest',behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'})});
 planner.querySelector<HTMLButtonElement>('[data-quote-copy]')?.addEventListener('click',async(event)=>{
 update();const button=event.currentTarget as HTMLButtonElement;const status=planner.querySelector<HTMLElement>('[data-quote-status]');const text=selects.map(select=>`${select.dataset.resultLabel}: ${select.value}`).concat(Array.from(planner.querySelectorAll('.pp-brief li')).map(li=>li.textContent??'')).join('\n');
 try{await navigator.clipboard.writeText(text);if(status)status.textContent=button.dataset.copied??''}catch{if(status)status.textContent=button.dataset.failed??''}
 });
 });
</script>
