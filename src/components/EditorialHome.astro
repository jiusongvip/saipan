---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from './ContactForm.astro';
import HomeDiscovery from './HomeDiscovery.astro';
import { buildVisiblePaths, loadAllPages, type PageData } from '../lib/content';
import { canonicalUrl } from '../lib/seo';
import type { LangCode } from '../lib/config';
import '../styles/editorial-home.css';
interface Props { lang: LangCode; page?: PageData | null }
const {lang, page=null}=Astro.props;
const en=lang==='en'; const hant=lang==='zh-hant';
const copy=en ? {
 title:'Room for a new beginning.', sub:'Fertility care. A clearer path. Your own pace.', consult:'Let’s talk', discover:'Explore your options', intro:'Your future. Your way.', introText:'A personal decision deserves thoughtful care—and space to breathe.', options:['Understand your options','Prepare for your visit','Plan with confidence'], descriptions:['Treatment & assessment','Travel & time on island','Costs & practical guidance'], care:'Science with a human touch.', careText:'Understand the people, processes and questions behind your care.', careLink:'Explore medical care', island:'A different setting.\nThe same focus: you.', islandText:'Discover Saipan, with room to pause between the important moments.', islandLink:'Discover Saipan', journey:'One step at a time.', steps:['Share your story','Explore a care plan','Prepare your journey','Stay connected'], start:'It starts with a conversation.', startText:'Bring your questions. We’ll help you understand the next step.', label:'SAIPAN · FERTILITY & FAMILY', note:'Illustrative photography', careNote:'Illustrative medical setting', nav:['Personal care','Clear information','Thoughtful support'], resources:'Before you begin', links:['Treatment options','Costs & planning','Travel essentials'], imageAlt:['A family sharing a moment outdoors','A conversation in a bright room','Green fern foliage','A laboratory setting','Saipan coast and lagoon']
} : hant ? {
 title:'塞班 IVF\n讓期待，更近一步。', sub:'塞班輔助生殖 · 按您的步調，走向下一步', consult:'從一次溝通開始', discover:'探索您的選擇', intro:'您的期待\n我們認真以待', introText:'讓複雜的選擇清楚一點，讓重要的決定從容一點。', options:['專屬生育方案','安心赴塞班','費用清楚 心裡有數'], descriptions:['治療方案與初步評估','入境、停留與就診準備','費用構成與實用指南'], care:'專業為底氣\n關懷有溫度', careText:'了解醫療資源、實驗室流程，以及就診前值得問的問題。', careLink:'了解醫療服務', island:'面朝大海\n靜候新生', islandText:'在塞班的海與天空之間，為就診之外的時光留白。', islandLink:'認識塞班', journey:'從諮詢到出發 步步清晰', steps:['聊聊您的期待','了解方案與費用','準備行程與資料','保持後續聯絡'], start:'您的好孕計劃\n現在開始', startText:'帶著問題來，先了解，再選擇。', label:'SAIPAN · FERTILITY & FAMILY', note:'人物情境示意', careNote:'醫療情境示意 · 非院方實拍', nav:['個人化關懷','清晰的資訊','有回應的支持'], resources:'出發之前，先了解', links:['治療與評估','費用與規劃','入境與出行'], imageAlt:['家人在戶外相伴的溫暖時刻','明亮空間中的一對一溝通','綠色蕨類植物特寫','醫療實驗室情境','塞班海岸與潟湖航拍']
} : {
 title:'塞班 IVF\n让期待，更近一步。', sub:'塞班辅助生殖 · 按您的步调，走向下一步', consult:'从一次沟通开始', discover:'探索您的选择', intro:'您的期待\n我们认真以待', introText:'让复杂的选择清楚一点，让重要的决定从容一点。', options:['专属生育方案','安心赴塞班','费用清楚 心里有数'], descriptions:['治疗方案与初步评估','入境、停留与就诊准备','费用构成与实用指南'], care:'专业为底气\n关怀有温度', careText:'了解医疗资源、实验室流程，以及就诊前值得问的问题。', careLink:'了解医疗服务', island:'面朝大海\n静候新生', islandText:'在塞班的海与天空之间，为就诊之外的时光留白。', islandLink:'认识塞班', journey:'从咨询到出发 步步清晰', steps:['聊聊您的期待','了解方案与费用','准备行程与资料','保持后续联络'], start:'您的好孕计划\n现在开始', startText:'带着问题来，先了解，再选择。', label:'SAIPAN · FERTILITY & FAMILY', note:'人物场景示意', careNote:'医疗场景示意 · 非院方实拍', nav:['个性化关怀','清晰的信息','有回应的支持'], resources:'出发之前，先了解', links:['治疗与评估','费用与规划','入境与出行'], imageAlt:['家人在户外相伴的温暖时刻','明亮空间中的一对一沟通','绿色蕨类植物特写','医疗实验室场景','塞班海岸与潟湖航拍']
};
const built=buildVisiblePaths(await loadAllPages());
const target=(...paths:string[])=>paths.map(p=>`/${lang}/${p}`).find(p=>built.has(p)) ?? '#consult';
const paths=[target('programs/ivf-icsi','articles'),target('entry-path','articles'),target('pricing','articles')];
const medical=target('hospital-lab','articles/lab-own-or-outsourced','programs/ivf-icsi');
const island=target('why-saipan','entry-path');
const alternates=(['zh-hans','zh-hant','en'] as const).filter(l=>built.has(`/${l}`)||built.has(`/${l}/`)).map(l=>({hreflang:l==='zh-hans'?'zh-Hans':l==='zh-hant'?'zh-Hant':'en',href:canonicalUrl(l==='zh-hans' && !page ? '/' : `/${l}`)}));
alternates.push({hreflang:'x-default',href:canonicalUrl('/')});

const heroSlides = [
 {src:'/images/saipan-lagoon-aerial.jpg', title:en?'Island escape.\nA new beginning.':hant?'海島度假\n安心求子':'海岛度假\n安心求子', label:en?'Island & care':hant?'海島與醫療':'海岛与医疗', text:en?'Plan your medical visit alongside time to rest in Saipan’s island setting.':hant?'把輔助生殖之旅，放進碧海藍天裡。':'把辅助生殖之旅，放进碧海蓝天里。', alt:copy.imageAlt[4]},
 {src:'/images/couple-editorial.jpg', title:en?'Expert care.\nA personal touch.':hant?'專業醫療\n溫暖相伴':'专业医疗\n温暖相伴', label:en?'Personal care':hant?'溫暖的專業':'温暖的专业', text:en?'One-to-one communication to understand your options, costs and preparation.':hant?'一對一了解需求，方案、費用、行程一次聊清。':'一对一了解需求，方案、费用、行程一次聊清。', alt:copy.imageAlt[1]},
 {src:'/images/american-flag.jpg', title:en?'Born in Saipan.\nA U.S. citizen?':hant?'塞班出生\n美國公民？':'塞班出生\n美国公民？', label:en?'Birth & documents':hant?'出生與證件':'出生与证件', text:en?'Explore U.S. citizenship rules, birth registration and travel documents before making plans.':hant?'孩子的身份規劃，從這裡了解。國籍資格依現行法律與個案認定。':'孩子的身份规划，从这里了解。国籍资格依现行法律与个案认定。', alt:en?'An American flag in the breeze':hant?'迎風飄揚的美國國旗':'迎风飘扬的美国国旗'},
 {src:'/images/flight-wing.jpg', title:en?'Next stop: Saipan.\nYour journey begins.':hant?'飛向塞班\n好孕啟程':'飞向塞班\n好孕启程', label:en?'Your journey':hant?'出行與航班':'出行与航班', text:en?'Compare direct and connecting routes, then coordinate arrival with your appointment.':hant?'直飛、中轉、接續就診——出發前，安排明白。':'直飞、中转、接续就诊——出发前，安排明白。', alt:en?'Airplane wing above the clouds':hant?'雲層上方的飛機機翼':'云层上方的飞机机翼'},
];

const metaTitle = page?.title ?? '塞班辅助生殖｜为新的可能，留一点空间';
const metaDescription = page?.description ?? '在塞班探索辅助生殖的更多可能，了解治疗评估、医疗资源、费用构成与跨境出行安排，从一次清晰的沟通开始。';
---
<BaseLayout lang={lang} title={metaTitle} description={metaDescription} canonical={canonicalUrl(page?.path??'/')} alternates={alternates} noindex={page?.noindex??false} pageType="home" page={page} hasForm={true} ogImage="/images/saipan-lagoon-aerial.jpg">
<section class="eh-hero" data-hero-carousel aria-roledescription={en?'carousel':'轮播'} aria-label={en?'Discover Saipan IVF':hant?'探索塞班 IVF':'探索塞班 IVF'}>
 <div class="eh-hero__slides">
 {heroSlides.map((slide,i)=><img class:list={['eh-hero__image',{'is-active':i===0}]} src={slide.src} alt={slide.alt} width={i===1?1400:1600} height="933" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} data-hero-image aria-hidden={i!==0?'true':undefined} />)}
 </div>
 <div class="eh-hero__shade"></div>
 <div class="container eh-hero__content"><p class="eh-kicker">{copy.label}</p><h1 data-hero-title>{heroSlides[0].title}</h1><p class="eh-hero__sub" data-hero-caption>{heroSlides[0].text}</p></div>
 <div class="container eh-hero__controls">
  <div class="eh-hero__tabs" aria-label={en?'Choose a photograph':hant?'切換主視覺':'切换主视觉'}>
   {heroSlides.map((slide,i)=><button type="button" class:list={['eh-hero__tab',{'is-active':i===0}]} aria-pressed={i===0} data-hero-tab data-caption={slide.text} data-title={slide.title}><small>0{i+1}</small><span>{slide.label}</span></button>)}
  </div>
  <div class="eh-hero__arrows"><button type="button" data-hero-pause aria-label={en?'Pause automatic slideshow':hant?'暫停自動輪播':'暂停自动轮播'} aria-pressed="false" data-pause-label={en?'Pause automatic slideshow':hant?'暫停自動輪播':'暂停自动轮播'} data-play-label={en?'Resume automatic slideshow':hant?'繼續自動輪播':'继续自动轮播'}>Ⅱ</button><button type="button" data-hero-prev aria-label={en?'Previous image':hant?'上一張圖片':'上一张图片'}>←</button><button type="button" data-hero-next aria-label={en?'Next image':hant?'下一張圖片':'下一张图片'}>→</button></div>
 </div>
 <span class="visually-hidden" data-hero-status aria-live="polite" aria-atomic="true"></span>
</section>
<aside class="eh-chat" data-consult-panel aria-label={en?'Online consultation':hant?'線上諮詢':'在线咨询'}>
 <div class="eh-chat__header"><span class="eh-chat__avatar" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg></span><div><strong>{en?'Let’s talk about your plans':hant?'塞班 IVF · 線上諮詢':'塞班 IVF · 在线咨询'}</strong><small>{en?'A clearer next step starts here':hant?'聊方案 · 問費用 · 做規劃':'聊方案 · 问费用 · 做规划'}</small></div><button type="button" data-consult-close aria-label={en?'Minimize consultation':hant?'收起諮詢窗口':'收起咨询窗口'}>−</button></div>
 <div class="eh-chat__body"><p class="eh-chat__hello">{en?'Hello, welcome 👋':hant?'您好，歡迎諮詢 👋':'您好，欢迎咨询 👋'}</p><p class="eh-chat__bubble">{en?'Thinking about fertility care in Saipan? What would you like to know first?':hant?'想去塞班做試管？先聊方案，再看預算。您的問題，從這裡開始。':'想去塞班做试管？先聊方案，再看预算。您的问题，从这里开始。'}</p><span class="eh-chat__prompt">{en?'Where would you like to start?':hant?'您想先了解哪方面？':'您想先了解哪方面？'}</span><div class="eh-chat__topics">{(en?['Treatment options','Costs & budget','Travel planning']:hant?['治療方案','費用預算','出行安排']:['治疗方案','费用预算','出行安排']).map(text=><a href="#consult">{text}<span>↗</span></a>)}</div><a class="eh-chat__cta" href="#consult">{en?'Tell us what you need':hant?'聊聊您的需求':'聊聊您的需求'}<span>→</span></a></div>
</aside>
<button type="button" class="eh-chat-launcher" data-consult-open hidden aria-expanded="false">{en?'Online consultation':hant?'線上諮詢':'在线咨询'}<span aria-hidden="true">↗</span></button>
<div class="eh-values"><div class="container">{copy.nav.map((text,i)=><span><small>0{i+1}</small>{text}</span>)}</div></div>
<section class="eh-intro container"><p class="eh-kicker">MADE PERSONAL</p><h2>{copy.intro}</h2><p>{copy.introText}</p></section>
<section class="container eh-portals" aria-label={copy.discover}>
 {copy.options.map((title,i)=><a class={`eh-portal eh-portal--${i}`} href={paths[i]}><img src={['/images/couple-editorial.jpg','/images/saipan-lagoon-aerial.jpg','/images/quiet-botanical.jpg'][i]} alt={copy.imageAlt[[1,4,2][i]]} width="1000" height="667" loading="lazy"/><div><small>0{i+1} / {copy.descriptions[i]}</small><h3>{title}<span>↗</span></h3></div></a>)}
</section>
<section class="container eh-care" id="medical-care"><div class="eh-care__photos"><img src="/images/care-consultation.jpg" alt={copy.imageAlt[1]} width="1000" height="667" loading="lazy"/><figure><img src="/images/laboratory-care.jpg" alt={copy.imageAlt[3]} width="1000" height="667" loading="lazy"/><figcaption>{copy.careNote}</figcaption></figure><span class="eh-orbit" aria-hidden="true">CARE<br/>WITH YOU<br/>IN MIND</span></div><div class="eh-care__copy"><p class="eh-kicker">THE SCIENCE. THE HUMAN.</p><h2>{copy.care}</h2><p>{copy.careText}</p><a class="eh-link" href={medical}>{copy.careLink}<span>↗</span></a></div></section>
<section class="eh-island"><img src="/images/saipan-lagoon-aerial.jpg" alt={copy.imageAlt[4]} width="1280" height="716" loading="lazy"/><div class="container"><div class="eh-island__card"><p class="eh-kicker">15°11′ N · 145°45′ E</p><h2>{copy.island}</h2><p>{copy.islandText}</p><a class="eh-link" href={island}>{copy.islandLink}<span>↗</span></a></div></div><span class="eh-island__word" aria-hidden="true">Saipan</span></section>
<section class="container eh-journey"><div><p class="eh-kicker">YOUR PACE. YOUR PATH.</p><h2>{copy.journey}</h2></div><ol>{copy.steps.map((step,i)=><li><span>0{i+1}</span><h3>{step}</h3></li>)}</ol></section>
<HomeDiscovery lang={lang} />
<section class="eh-start container"><p class="eh-kicker">LET’S BEGIN</p><h2>{copy.start}</h2><p>{copy.startText}</p><a class="eh-button eh-button--dark" href="#consult">{copy.consult}<span>↗</span></a></section>
<ContactForm lang={lang} pageType="home" pagePath={page?.path??'/'} ctaLabel={copy.consult}/>
</BaseLayout>

<script>
 document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach((hero)=>{
  const images=Array.from(hero.querySelectorAll<HTMLImageElement>('[data-hero-image]'));
  const tabs=Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-tab]'));
  const caption=hero.querySelector<HTMLElement>('[data-hero-caption]');
  const title=hero.querySelector<HTMLElement>('[data-hero-title]');
  const status=hero.querySelector<HTMLElement>('[data-hero-status]');
  const pauseButton=hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  let active=0, paused=reduced.matches, hovered=false, visible=true;
  let timer:ReturnType<typeof setInterval>|undefined;
  function syncTimer(){
   clearInterval(timer);
   if(!paused&&!hovered&&visible&&!document.hidden&&!hero.contains(document.activeElement))timer=setInterval(()=>show(active+1,false),6500);
  }
  function show(index:number,manual=true){
   active=(index+images.length)%images.length;
   images.forEach((img,i)=>{img.classList.toggle('is-active',i===active);if(i===active){img.removeAttribute('aria-hidden');img.loading='eager'}else img.setAttribute('aria-hidden','true')});
   tabs.forEach((tab,i)=>{tab.classList.toggle('is-active',i===active);tab.setAttribute('aria-pressed',String(i===active))});
   if(caption)caption.textContent=tabs[active].dataset.caption??'';
   if(title)title.textContent=tabs[active].dataset.title??'';
   if(manual&&status)status.textContent=`${active+1} / ${images.length} · ${tabs[active].textContent}`;
   syncTimer();
  }
  function syncPause(){if(pauseButton){pauseButton.textContent=paused?'▶':'Ⅱ';pauseButton.setAttribute('aria-pressed',String(paused));pauseButton.setAttribute('aria-label',(paused?pauseButton.dataset.playLabel:pauseButton.dataset.pauseLabel)??'')}syncTimer()}
  pauseButton?.addEventListener('click',()=>{paused=!paused;syncPause()});
  tabs.forEach((tab,i)=>tab.addEventListener('click',()=>show(i)));
  hero.querySelector('[data-hero-prev]')?.addEventListener('click',()=>show(active-1));
  hero.querySelector('[data-hero-next]')?.addEventListener('click',()=>show(active+1));
  hero.addEventListener('mouseenter',()=>{hovered=true;syncTimer()});
  hero.addEventListener('mouseleave',()=>{hovered=false;syncTimer()});
  hero.addEventListener('focusin',syncTimer);
  hero.addEventListener('focusout',()=>setTimeout(syncTimer,0));
  document.addEventListener('visibilitychange',syncTimer);
  reduced.addEventListener('change',()=>{paused=reduced.matches;syncPause()});
  if('IntersectionObserver' in window)new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;syncTimer()},{threshold:.15}).observe(hero);
  hero.addEventListener('keydown',(event)=>{if(!(event.target instanceof Element)||!event.target.closest('button'))return;if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();show(active+(event.key==='ArrowRight'?1:-1));tabs[active].focus()}});
  let touchStart:number|null=null;
  hero.addEventListener('touchstart',(event)=>{touchStart=event.touches[0]?.clientX??null},{passive:true});
  hero.addEventListener('touchend',(event)=>{if(touchStart===null)return;const delta=(event.changedTouches[0]?.clientX??touchStart)-touchStart;if(Math.abs(delta)>55)show(active+(delta<0?1:-1));touchStart=null},{passive:true});
  syncPause();
 });
</script>

<script>
 const panel=document.querySelector<HTMLElement>('[data-consult-panel]');
 const launcher=document.querySelector<HTMLButtonElement>('[data-consult-open]');
 document.querySelector('[data-consult-close]')?.addEventListener('click',()=>{if(panel&&launcher){panel.hidden=true;launcher.hidden=false;launcher.setAttribute('aria-expanded','false');launcher.focus()}});
 launcher?.addEventListener('click',()=>{if(panel){panel.hidden=false;launcher.hidden=true;launcher.setAttribute('aria-expanded','true');panel.querySelector<HTMLButtonElement>('[data-consult-close]')?.focus()}});
 panel?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{if(launcher){panel.hidden=true;launcher.hidden=false;launcher.setAttribute('aria-expanded','false')}}));
</script>
