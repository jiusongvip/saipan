---
import MarketingImage from './marketing/MarketingImage.astro';
import { getDiscoveryCopy } from '../data/marketing/discovery';
import type { LangCode } from '../lib/config';
import { buildVisiblePaths, loadAllPages } from '../lib/content';
const { lang } = Astro.props as { lang: LangCode };
const built = buildVisiblePaths(await loadAllPages());
const route = (...slugs: string[]) =>
  slugs.map((s) => `/${lang}/${s}`).find((p) => built.has(p)) ?? '#consult';
const c = getDiscoveryCopy(lang);
const links = [
  route('pricing', 'articles/price-ranges-and-addon-items'),
  route('entry-path'),
  route('legal/parenthood-and-birth-registration', 'articles/us-born-baby-advantages'),
  route('articles/flights-to-saipan-routes', 'entry-path'),
];
---

<section class="hd-quick container">
  <h2 data-reveal>{c.tools}</h2>
  <div>
    {c.quick.map((text, i) => (
      <a href={links[i]} data-reveal style={`--rd:${i}`}>
        <h3>{text}</h3>
        <p>{c.notes[i]}</p>
        <b aria-hidden="true">↗</b>
      </a>
    ))}
  </div>
</section>
<section class="hd-life">
  <div class="container">
    <h2 data-reveal>{c.life}</h2>
    <p class="hd-lede" data-reveal style={`--rd:1`}>{c.lifeText}</p>
    <div class="hd-life__gallery">
      {c.gallery.map((title, i) => (
        <figure data-reveal style={`--rd:${i + 2}`}>
          <MarketingImage
            src={['/images/stay-room.jpg', '/images/island-pool.jpg', '/images/daily-meals.jpg'][i]}
            alt={title}
            width="1200"
            height="800"
            loading="lazy"
          />
          <figcaption>
            <h3>{title}</h3>
            <p>{c.galleryText[i]}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="hd-note">{c.demo}</p>
  </div>
</section>
<section
  class="hd-planner container"
  data-trip-planner
  data-treatment={c.treatment}
  data-birth={c.birth}
  data-explore={c.explore}
  data-simple={c.simple}
  data-comfort={c.comfort}
  data-family={c.family}
>
  <div data-reveal>
    <h2>{c.plan}</h2>
    <p class="hd-lede">{c.planText}</p>
    <div class="hd-planner__fields">
      <label>
        {c.profile}
        <select data-trip-focus>
          {c.profiles.map((label, i) => (
            <option value={i}>{label}</option>
          ))}
        </select>
      </label>
      <label>
        {c.stay}
        <select data-trip-stay>
          {c.stays.map((label, i) => (
            <option value={i}>{label}</option>
          ))}
        </select>
      </label>
    </div>
    <button type="button" class="eh-button eh-button--dark" data-trip-generate>
      {c.button}
      <span>↗</span>
    </button>
  </div>
  <div class="hd-checklist" aria-live="polite" data-reveal style={`--rd:1`}>
    <h3>{c.result}</h3>
    <ul>
      {c.base.map((text) => (
        <li>{text}</li>
      ))}
      <li data-trip-focus-result>{c.treatment}</li>
      <li data-trip-stay-result>{c.simple}</li>
    </ul>
    <a class="eh-link" href="#consult">
      {c.next}
      <span>↗</span>
    </a>
  </div>
</section>
<section class="hd-faq container">
  <div data-reveal>
    <h2>{c.faq}</h2>
  </div>
  <div data-reveal style={`--rd:1`}>
    {c.questions.map((q, i) => (
      <details id={i === 2 ? 'birth-documents' : undefined}>
        <summary>{q}</summary>
        <p>{c.answers[i]}</p>
        {i < 3 && (
          <a class="eh-link" href={links[[0, 3, 2][i]]}>
            {c.read}
            <span>↗</span>
          </a>
        )}
      </details>
    ))}
  </div>
</section>
<script>
  import '../scripts/trip-planner';
</script>
