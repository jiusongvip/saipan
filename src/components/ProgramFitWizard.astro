      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    donor_sperm: {
      concerns: [
        'Sperm source and legal procedure',
        'Legal agreement and rights/obligations',
        'What is included in the fee',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    surrogacy: {
      concerns: [
        'Surrogacy agreement and process',
        'Legal jurisdiction and document requirements',
        'What is included and possible add-ons',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    lgbtq: {
      concerns: [
        "Partners' legal relationship and documents",
        'Program process and monitoring arrangements',
        'What is included in the fee',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    recurrent_failure: {
      concerns: [
        'Past treatment records and failure cause analysis',
        'Whether additional tests or evaluation are needed',
        'Possibility of program adjustment',
        'What is included in the fee',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    unsure: {
      concerns: [
        'What information is needed for initial evaluation',
        'Which pages to read first',
        'Suggested contact methods and question list',
      ],
      pages: ['/why-saipan', '/programs/ivf-icsi', '/pricing'],
    },
  },
};

const suggestions = SUGGESTIONS[lang] ?? SUGGESTIONS.en;
const langPrefix = lang === 'zh-hant' ? '/zh-hant' : lang === 'zh-hans' ? '/zh-hans' : '/en';

// 建议阅读页只保留本次构建真实渲染的落点：草稿页、该语言未建的页面不生成链接（防 404）。
const wizardData = Object.fromEntries(
  Object.entries(suggestions).map(([key, item]) => [
    key,
    {
      concerns: item.concerns,
      pages: item.pages
        .map((p) => ({ href: `${langPrefix}${p}`, label: p }))
        .filter((p) => visiblePaths.has(p.href)),
    },
  ]),
);
---

<div
  class="wizard"
  id="wizard"
  data-program-wizard
  data-lang={lang}
  data-wizard-data={JSON.stringify(wizardData)}
>
  <!-- 步骤指示器 -->
  <div class="wizard__steps" aria-hidden="true">
    <span class="wizard__step wizard__step--active" data-wizard-step="1">
      1
    </span>
    <span class="wizard__step" data-wizard-step="2">
      2
    </span>
    <span class="wizard__step" data-wizard-step="3">
      3
    </span>
  </div>

  <!-- 步骤 1：意图（方案） -->
  <fieldset class="wizard__panel" data-wizard-panel="1">
    <legend>{t(lang, 'wizard.step1_title')}</legend>
    <p class="wizard__hint">{t(lang, 'wizard.step1_hint')}</p>
    <div class="field">
      <label class="field__label" for="wizard-program">
        {t(lang, 'form.program')}
      </label>
      <select class="select" id="wizard-program" required>
        <option value="">{t(lang, 'wizard.select')}</option>
        {PROGRAM_VALUES.map((value) => (
          <option value={value}>{t(lang, `program.${value}`)}</option>
        ))}
      </select>
    </div>
    <button class="btn btn--primary" type="button" data-wizard-next>
      {t(lang, 'wizard.next')}
    </button>
  </fieldset>

  <!-- 步骤 2：条件（年龄/国家/既往治疗） -->
  <fieldset class="wizard__panel" data-wizard-panel="2" hidden>
    <legend>{t(lang, 'wizard.step2_title')}</legend>
    <p class="wizard__hint">{t(lang, 'wizard.step2_hint')}</p>
    <div class="field">
      <label class="field__label" for="wizard-age">
        {t(lang, 'form.age')}
      </label>
      <input class="input" id="wizard-age" type="number" min="18" max="75" inputmode="numeric" />
    </div>
    <div class="field">
      <label class="field__label" for="wizard-country">
        {t(lang, 'form.country')}
      </label>
      <input class="input" id="wizard-country" type="text" maxlength="80" />
    </div>
    <div class="field">
      <label class="field__label" for="wizard-past-treatment">
        {t(lang, 'form.past_treatment')}
      </label>
      <textarea class="textarea" id="wizard-past-treatment" maxlength="400"></textarea>
    </div>
    <div class="wizard__actions">
      <button class="btn btn--secondary" type="button" data-wizard-prev>
        {t(lang, 'wizard.prev')}
      </button>
      <button class="btn btn--primary" type="button" data-wizard-next>
        {t(lang, 'wizard.next')}
      </button>
    </div>
  </fieldset>

  <!-- 步骤 3：时间 -->
  <fieldset class="wizard__panel" data-wizard-panel="3" hidden>
    <legend>{t(lang, 'wizard.step3_title')}</legend>
    <p class="wizard__hint">{t(lang, 'wizard.step3_hint')}</p>
    <div class="field">
      <label class="field__label" for="wizard-timeline">
        {t(lang, 'form.timeline')}
      </label>
      <select class="select" id="wizard-timeline" required>
        <option value="">{t(lang, 'wizard.select')}</option>
        {TIMELINE_VALUES.map((value) => (
          <option value={value}>{t(lang, `timeline.${value}`)}</option>
        ))}
      </select>
    </div>
    <div class="wizard__actions">
      <button class="btn btn--secondary" type="button" data-wizard-prev>
        {t(lang, 'wizard.prev')}
      </button>
      <button class="btn btn--primary" type="button" data-wizard-finish>
        {t(lang, 'wizard.finish')}
      </button>
    </div>
  </fieldset>

  <!-- 结果（不留电话即可看到） -->
  <div class="wizard__result" data-wizard-result hidden>
    <h3>{t(lang, 'wizard.result_title')}</h3>
    <p class="wizard__note">{t(lang, 'wizard.result_note')}</p>
    <div class="wizard__concerns">
      <h4>{t(lang, 'wizard.concerns_title')}</h4>
      <ul data-wizard-concerns></ul>
    </div>
    <div class="wizard__pages">
      <h4>{t(lang, 'wizard.pages_title')}</h4>
      <ul data-wizard-pages></ul>
    </div>
    <p class="wizard__no-contact">{t(lang, 'wizard.no_contact')}</p>
    <button class="btn btn--primary" type="button" data-wizard-to-form>
      {t(lang, 'wizard.to_form')}
    </button>
  </div>
</div>

<script>
  (() => {
    const container = document.querySelector<HTMLElement>('[data-program-wizard]');
    if (!container) return;
    const data = JSON.parse(container.dataset.wizardData ?? '{}') as Record<
      string,
      { concerns: string[]; pages: { href: string; label: string }[] }
    >;

    const panels = container.querySelectorAll<HTMLElement>('[data-wizard-panel]');
    const result = container.querySelector<HTMLElement>('[data-wizard-result]');
    const concernsList = container.querySelector<HTMLElement>('[data-wizard-concerns]');
    const pagesList = container.querySelector<HTMLElement>('[data-wizard-pages]');
    const stepIndicators = container.querySelectorAll<HTMLElement>('[data-wizard-step]');

    let currentStep = 1;

    function showStep(step: number) {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.wizardPanel !== String(step);
      });
      stepIndicators.forEach((indicator) => {
        const s = Number(indicator.dataset.wizardStep);
        indicator.classList.toggle('wizard__step--active', s === step);
        indicator.classList.toggle('wizard__step--done', s < step);
      });
      currentStep = step;
    }

    function showResult() {
      if (!container) return;
      const programSelect = container.querySelector<HTMLSelectElement>('#wizard-program');
      const program = programSelect?.value ?? 'unsure';
      const item = data[program] ?? data.unsure;
      if (!item) return;

      if (concernsList) {
        concernsList.innerHTML = item.concerns.map((c) => `<li>${c}</li>`).join('');
      }
      if (pagesList) {
        pagesList.innerHTML = item.pages
          .map((p) => `<li><a href="${p.href}">${p.label}</a></li>`)
          .join('');
        if (pagesList.parentElement) pagesList.parentElement.hidden = item.pages.length === 0;
      }

      panels.forEach((panel) => {
        panel.hidden = true;
      });
      if (result) result.hidden = false;
      stepIndicators.forEach((indicator) => {
        indicator.classList.add('wizard__step--done');
      });
    }

    container.querySelectorAll<HTMLButtonElement>('[data-wizard-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (currentStep < 3) showStep(currentStep + 1);
      });
    });

    container.querySelectorAll<HTMLButtonElement>('[data-wizard-prev]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (currentStep > 1) showStep(currentStep - 1);
      });
    });

    const finishBtn = container.querySelector<HTMLButtonElement>('[data-wizard-finish]');
    finishBtn?.addEventListener('click', () => {
      showResult();
    });

    const toFormBtn = container.querySelector<HTMLButtonElement>('[data-wizard-to-form]');
    toFormBtn?.addEventListener('click', () => {
      const form = document.querySelector<HTMLElement>('#consult');
      form?.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>
