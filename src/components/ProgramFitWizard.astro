      pages: ['/why-saipan', '/programs/ivf-icsi', '/pricing'],
    },
  },
  en: {
    ivf: {
      concerns: [
        'Whether past treatment records need translation or an English summary',
        'How stimulation protocol and medication dosage are arranged for your situation',
        'How to choose between IVF and ICSI',
        'Culture days and transfer strategy (Day 3 or Day 5)',
        'What is included in the fee and what are possible add-ons',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    egg_freezing: {
      concerns: [
        'Whether past treatment records need translation',
        'Expected egg count and storage duration',
        'Thawing timing and connection to subsequent programs',
        'What is included and the annual storage fee',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
