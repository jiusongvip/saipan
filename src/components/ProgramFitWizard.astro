      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    donor_egg: {
      concerns: [
        '供者筛选标准与匹配流程',
        '法律协议与权利义务',
        '费用包含项目与可能加项',
        '跨境医疗的文件要求',
      ],
      pages: ['/programs/ivf-icsi', '/pricing', '/faq'],
    },
    donor_sperm: {
