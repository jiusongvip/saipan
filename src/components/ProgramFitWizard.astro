---
import { PROGRAM_VALUES, TIMELINE_VALUES } from '../lib/forms';
import { buildVisiblePaths, loadAllPages } from '../lib/content';
import { t } from '../lib/i18n';
import type { LangCode } from '../lib/config';

export interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const pages = await loadAllPages();
const visiblePaths = buildVisiblePaths(pages);

// 建议内容（纯方法，基于方案类型；不含医疗/价格/入境事实）
