{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".astro/cache"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strictNullChecks": true
  }
}
